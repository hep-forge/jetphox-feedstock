+	    call evolvepdfm(2,x,m,dxpdf)
+	  else
+	    call evolvepdf(x,m,dxpdf)
+	  endif
+	  if (ih.eq.4) then
+	    f(0) = dxpdf(0)/x
+	    do i=1,6
+	      f(i) = dxpdf(i)/x
+	      f(-i) = dxpdf(-i)/x
+	    enddo
+	    return
+	  endif
 	  f(0) = dxpdf(0)/x
 	  do i=1,6
 	    f(i) = dxpdf(-i)/x
